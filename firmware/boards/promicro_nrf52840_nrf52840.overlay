/*
 * Device Tree Overlay for LED Copper String Controller (simple PWM variant)
 * Target: Pro Micro nRF52840 (SuperMini, nice!nano compatible)
 *
 * - LED PWM:        P0.10 - PWM0 ch0, 1 kHz, active high
 * - Pairing Button: P0.06 (D1) - Active low with internal pull-up
 * - Status LED:     P0.15 (onboard) - PWM0 ch1: mirrors the LED PWM, blinks
 *                   while not joined
 *
 * P0.10 is an NFC pin; the board sets nfct-pins-as-gpios in UICR.
 *
 * Note: Flash partitions are auto-generated by partition manager
 * when CONFIG_BOOTLOADER_MCUBOOT=y (for OTA support).
 */

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		/* settings-partition auto-configured by partition manager */
	};

	aliases {
		sw0 = &pairing_button;
	};

	pwmleds {
		compatible = "pwm-leds";

		led_pwm: led_pwm {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "LED PWM";
		};

		status_pwm: status_pwm {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Status LED";
		};
	};

	buttons {
		compatible = "gpio-keys";
		pairing_button: button_0 {
			gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Pairing Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

/* PWM0: ch0 -> P0.10 (LED output), ch1 -> P0.15 (onboard LED) */
&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 10)>,
				<NRF_PSEL(PWM_OUT1, 0, 15)>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 10)>,
				<NRF_PSEL(PWM_OUT1, 0, 15)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
};

/*
 * Detect button edges with the GPIO SENSE (PORT event) mechanism instead of
 * a GPIOTE IN channel, which draws considerably more current in sleep.
 */
&gpio0 {
	status = "okay";
	sense-edge-mask = <(1 << 6)>;
};
