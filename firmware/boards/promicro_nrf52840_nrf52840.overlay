/*
 * Device Tree Overlay for LED Copper String Controller
 * Target: Pro Micro nRF52840 (SuperMini, nice!nano compatible)
 *
 * TB6612 H-Bridge Pin Assignments:
 * - AIN1:    P0.20 - PWM0 ch0, normal polarity   (polarity A window)
 * - AIN2:    P0.17 - PWM0 ch1, inverted polarity (polarity B window)
 * - PWMA:    P0.22 - GPIO, HIGH while lit
 * - STANDBY: P0.24 - GPIO, HIGH while lit, LOW = standby
 *
 * Battery Measurement (voltage divider):
 * - VBATT -> 1MΩ -> P0.31 (AIN7) -> 1MΩ -> P0.29
 * - P0.29: Drive LOW to enable divider, high-Z when idle
 * - P0.31: Analog input (AIN7), measures VBATT/2
 *
 * Other:
 * - Pairing Button: P0.06 (D1) - Active low with internal pull-up
 * - Status LED: P0.15 (onboard) - For network status indication
 *
 * Note: Flash partitions are auto-generated by partition manager
 * when CONFIG_BOOTLOADER_MCUBOOT=y (for OTA support).
 */

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		/* settings-partition auto-configured by partition manager */
	};

	aliases {
		sw0 = &pairing_button;
		led0 = &led0;  /* Onboard LED (P0.15) for status */
	};

	/*
	 * TB6612 AIN1/AIN2. Both channels must share one PWM instance and
	 * period; AIN2 is inverted so its pulse sits at the end of the period
	 * and never overlaps AIN1. Period = per-polarity refresh rate (1 kHz).
	 */
	pwmleds {
		compatible = "pwm-leds";

		tb6612_ain1: tb6612_ain1 {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "TB6612 AIN1";
		};

		tb6612_ain2: tb6612_ain2 {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "TB6612 AIN2";
		};
	};

	/* TB6612 static GPIO control pins */
	tb6612_ctrl {
		compatible = "gpio-leds";

		tb6612_pwma: pwma {
			gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
			label = "TB6612 PWMA";
		};

		tb6612_standby: standby {
			gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
			label = "TB6612 STANDBY";
		};
	};

	buttons {
		compatible = "gpio-keys";
		pairing_button: button_0 {
			gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Pairing Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/* Battery voltage divider control */
	battery_divider {
		compatible = "gpio-leds";
		batt_divider_gnd: batt_gnd {
			gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
			label = "Battery Divider GND";
		};
	};
};

/* PWM0: ch0 -> P0.20 (AIN1), ch1 -> P0.17 (AIN2) */
&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 20)>,
				<NRF_PSEL(PWM_OUT1, 0, 17)>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 20)>,
				<NRF_PSEL(PWM_OUT1, 0, 17)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
};

/*
 * Detect button edges with the GPIO SENSE (PORT event) mechanism instead of
 * a GPIOTE IN channel, which draws considerably more current in sleep.
 */
&gpio0 {
	status = "okay";
	sense-edge-mask = <(1 << 6)>;
};
